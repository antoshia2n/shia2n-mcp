{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shia2n-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    // 2026-08-08 変更：売上管理を Vercel から Cloudflare Pages へ移した。
    // 旧: https://sales-manager-black.vercel.app（置き場ごと削除する予定）
    "SALES_MANAGER_API_BASE": "https://sales-manager.shia2n.jp",
    "UTAGE_API_BASE": "https://api.utage-system.com/v1",
    // 2026-08-03 追加：zeus-worker（Notion → Zeus 同期）の起動先。
    // 秘密ではない公開URLのため、画面ではなくこの設定ファイル側で管理する。
    // 画面で追加したプレーンテキスト変数は、この vars を含むデプロイで
    // 置き換えられて消えるため、ここに書くのが正。
    // 合言葉（ZEUS_WORKER_SECRET）はシークレットなので画面側で管理する。
    "ZEUS_WORKER_URL": "https://zeus-worker.gameister1.workers.dev"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "eebf082265bf4d93906382a83d069d45"
    }
  ],
  // 2026-08-05 追加：データの控えの置き場。
  // Supabase の外に置くことが要件なので Supabase Storage は使わない。
  "r2_buckets": [
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "shia2n-backup"
    }
  ],
  // 2026-09-06 切り替えの日：権利を組み直す定時実行（毎時 15 分と 45 分）を外した。
  // 外した理由＝会員の表を旧から新へ移している最中に走ると、新旧が食い違うため（作業 79）。
  // 元に戻すときは "15,45 * * * *" の 1 行を crons へ戻す。
  // ただし切り替えが済んだ後は、新しい権利の表を見ていないので戻す意味が無い（作業 79）。
  "triggers": {
    "crons": [
      "0,30 * * * *"
    ]
  }
}
